        selected = [s for s in candidate_samples if s['sample_id'] in normalized_sample_ids]
    elif project_id is not None:
        selected = [s for s in candidate_samples if s['project_name'] == project_id]
    else:
        selected = candidate_samples

    return selected, fastq_subdir


def select_gridion_samples(run_dir: Path, normalized_sample_ids: Optional[set[str]], project_id: Optional[str]=None):
    """
    Locate the GridION SampleSheet and return samples matching the given IDs or project,
    together with the path to the fastq subdirectory.

    normalized_sample_ids should already have underscores converted to hyphens, or be None.

    :param run_dir: Path to the GridION run directory
    :type run_dir: str
    :param normalized_sample_ids: Set of normalized sample IDs to filter on, or None
    :type normalized_sample_ids: set[str]|None
    :param project_id: Project ID to filter on, or None
    :type project_id: str|None
    :return: (selected_samples, fastq_subdir)
    :rtype: tuple[list[dict], str|None]
    """
    run_id = run_dir.name
    fastq_subdir = "fastq_pass_combined"
    samplesheet_paths = sorted(glob.glob(os.path.join(run_dir, 'sample_sheet_*.csv')))
    if not samplesheet_paths:
        logging.warning(f"Failed to find SampleSheet in: {run_dir}")
        return [], fastq_subdir

    all_samples = parse_samplesheet_gridion(samplesheet_paths[0])
    candidate_samples = [s for s in all_samples if has_necessary_fields_for_symlinking(s, 'gridion')]
    for s in candidate_samples:
        s['sample_id'] = normalize_sample_id(s['sample_id'])

    if normalized_sample_ids:
        selected = [s for s in candidate_samples if s['sample_id'] in normalized_sample_ids]
    elif project_id is not None:
        selected = [s for s in candidate_samples if s['project_id'] == project_id]
    else:
        selected = candidate_samples

    return selected, fastq_subdir


def get_fastq_paths(config: Config, run_dir: Path, sample_ids, project_id):
    """
    Get paths to source and destination of fastq files for a single run directory.

    :param config: App config.
    :type config: Config
    :param run_dir: Path to the sequencing run directory
    :type run_dir: str
    :param sample_ids: Collection of sample IDs to filter on, or empty/None for no ID filter
    :type sample_ids: set[str]|None
    :param project_id: Project ID to filter on, or None
    :type project_id: str|None
    :return: List of FastqFile records
    :rtype: list[FastqFile]
    """
    run_id = run_dir.name
    sequencer_type = determine_sequencer_type(run_id)
    if sequencer_type is None:
        return []

    # Normalize user-supplied IDs once, before dispatching to sequencer-specific helpers.
    normalized_sample_ids = {normalize_sample_id(s) for s in sample_ids} if sample_ids else None

    if sequencer_type == 'miseq':
        selected_samples, fastq_subdir = select_miseq_samples(run_dir, normalized_sample_ids, project_id)
    elif sequencer_type == 'nextseq':
        selected_samples, fastq_subdir = select_nextseq_samples(run_dir, normalized_sample_ids, project_id)
    elif sequencer_type == 'i100':
        selected_samples, fastq_subdir = select_i100_samples(run_dir, normalized_sample_ids, project_id)
    elif sequencer_type == 'gridion':
        selected_samples, fastq_subdir = select_gridion_samples(run_dir, normalized_sample_ids, project_id)
    else:
        return []

    if fastq_subdir is None:
        return []

    fastq_files = []
    for sample in selected_samples:
        sample_id = sample['sample_name'] if sequencer_type == 'miseq' else sample['sample_id']
        if not sample_id:
            continue

        matched = (
            glob.glob(os.path.join(run_dir, fastq_subdir, sample_id + '_*.fastq')) +
            glob.glob(os.path.join(run_dir, fastq_subdir, sample_id + '_*.fastq.gz'))
        )
        for path in matched:
            if os.path.exists(path):
                src = os.path.abspath(path)
                dest_filename = os.path.basename(path)
                resolved_id = dest_filename.split('_')[0]
                if config.simplify_sample_id:
                    dest_filename = simplify_fastq_filename(resolved_id, dest_filename)
                fastq_files.append(FastqFile(src=src, dest_filename=dest_filename, sample_id=resolved_id))

    return fastq_files


def determine_read_type(fastq_path):
    """
    Determine whether the fastq is an R1, R2 or RL file.

    :param fastq_path:
    :type fastq_path: str
    :return: "R1", "R2", "RL", or None if the read type cannot be determined.
    :rtype: str|None
    """
    m = re.search(READ_TYPE_REGEX, fastq_path)
    return m.group(1) if m else None


def pair_fastq_paths(fastq_files):
    """
    Group FastqFile records by sample ID and produce paired records for CSV output.
    Long-read (RL) files are mapped to R1 for pipeline input compatibility.

    :param fastq_files: List of FastqFile records
    :type fastq_files: list[FastqFile]
    :return: List of dicts with fields: ID, R1, R2
    :rtype: list[dict[str, str]]
    """
    paired = {}
    for f in fastq_files:
        read_type = determine_read_type(f.src)
        if f.sample_id not in paired:
            paired[f.sample_id] = {'ID': f.sample_id}
        if read_type == 'RL':
            # Long reads have no R2; map to R1 for downstream pipeline input.
            paired[f.sample_id]['R1'] = f.src
        elif read_type is not None:
            paired[f.sample_id][read_type] = f.src

    return sorted(paired.values(), key=lambda x: x['ID'])


def check_qc_status(run_dir, verbose=False):
    """
    Check the QC status for a run by reading qc_check_complete.json.
    Returns "PASS", "FAIL", or None if the file is absent or cannot be parsed.

    :param run_dir:
    :type run_dir: str
    :return: "PASS", "FAIL", or None
    :rtype: str|None
    """
    qc_status_path = os.path.join(run_dir, 'qc_check_complete.json')
    if not os.path.exists(qc_status_path):
        logging.warning(f"QC check file not found in: {run_dir}")
        return None
    try:
        with open(qc_status_path, 'r') as f:
            qc_check = json.load(f)
        return qc_check.get('overall_pass_fail')
    except (json.decoder.JSONDecodeError, KeyError) as e:
        logging.warning(f"Failed to parse QC check file in {run_dir}: {e}")
        return None


def should_skip_run(config: Config, run_dir: Path) -> tuple[bool, Optional[str]]:
    """
    Determine whether a sequencing run should be skipped due to exclusion rules or QC status.

    :param run_dir:
    :type run_dir: Path
    :param config:
    :type config: Config
    :param run_id:
    :type run_id: str
    :return: (skip, reason) tuple
    :rtype: tuple[bool, str|None]
    """
    run_id = run_dir.name
    if run_id in config.excluded_runs:
        return True, "excluded"
    if not config.skip_qc_status_check:
        qc_status = check_qc_status(run_dir)
        if qc_status != 'PASS':
            return True, f"QC status {qc_status!r}"
    return False, None


def main(config: Config):
    
    # jdump(config)
    # exit()

    if not config.csv and not config.outdir:
        logging.error('Please provide -o or --outdir when creating symlinks')
        exit(-1)

    if config.outdir and not os.path.exists(config.outdir):
        os.makedirs(config.outdir, exist_ok=True)

    sample_ids = set()
    if args.ids_file is not None:
        sample_ids = parse_ids_file(args.ids_file)

    # In csv-mode, write the header once before the run loop.
    writer = None
    if config.csv:
        output_fieldnames = ['ID', 'R1', 'R2']
        writer = csv.DictWriter(sys.stdout, fieldnames=output_fieldnames, extrasaction='ignore')
        writer.writeheader()

    for run_parent_dir in config.sequencing_run_parent_dirs:
        run_parent_dir_contents = list(map(lambda x: Path(os.path.abspath(os.path.join(run_parent_dir, x))), os.listdir(run_parent_dir)))
        run_dirs = list(filter(lambda x: os.path.isdir(x), run_parent_dir_contents))

        # If a run ID is supplied by the `--run-id` flag, only process that run.
        if config.run_id:
            run_dirs = list(filter(lambda x: x.name == config.run_id, run_dirs))

        for run_dir in run_dirs:
            run_id = run_dir.name

            skip, reason = should_skip_run(config, run_dir)
            if skip:
                logging.warning(f"Skipping run {run_id}: {reason}")
                continue

            # Apply per-run library exclusions to the sample ID filter set.
            excluded_libs = config.excluded_libraries_by_sequencing_run_id.get(run_id, set())
            # When sample_ids were specified but all are excluded for this run, skip the run
            # rather than falling through to project-based selection.
            if sample_ids:
                effective_sample_ids = sample_ids - excluded_libs
                if not effective_sample_ids:
                    continue
            else:
                effective_sample_ids = None

            fastq_files = get_fastq_paths(config, run_dir, effective_sample_ids, config.project_id)

            if config.copy:
                create_copies(fastq_files, config.outdir)
            elif config.csv:
                for row in pair_fastq_paths(fastq_files):
                    if writer:
                        writer.writerow(row)
            else:
                create_symlinks(fastq_files, config.outdir)


