VERSION = "0.1.2"

# Run ID patterns for each supported sequencer type.
MISEQ_RUN_ID_REGEX = r'\d{6}_M\d{5}_\d{4}_\d{9}-[A-Z0-9]{5}'
NEXTSEQ_RUN_ID_REGEX = r'\d{6}_VH\d{5}_\d+_[A-Z0-9]{9}'
I100_RUN_ID_REGEX = r'\d{8}_SH\d{5}_\d+_[A-Z0-9]{10}-[A-Z0-9]{3}'
GRIDION_RUN_ID_REGEX = r'\\d{8}_\d{4}_X\d_[A-Z]{3}\d+_[a-z0-9]{8}'

# Pattern for extracting read type (R1, R2, RL) from fastq filenames.
READ_TYPE_REGEX = r'_(R[12L])[_\.]'

# Helper fn for serializing json 
class EnhancedJSONEncoder(json.JSONEncoder):
    def default(self, o):
        if is_dataclass(o):
            return asdict(o)
        if isinstance(o, set):
            return list(o)
        if isinstance(o, os.PathLike):
            return str(o)
        return super().default(o)

@dataclass
class FastqFile:
    """Internal representation of a fastq file to be linked or copied."""
    src: str
    dest_filename: str
    sample_id: str

@dataclass
class Config:
    sequencing_run_parent_dirs: list[os.PathLike] = field(default_factory=list)
    project_id: Optional[str] = None
    run_id: Optional[str] = None
    simplify_sample_id: bool = False
    skip_qc_status_check: bool = False
    verbose: bool = False
    excluded_runs_file: Optional[os.PathLike] = None
    excluded_libraries_file: Optional[os.PathLike] = None
    excluded_runs: set[str] = field(default_factory=set)
    excluded_libraries_by_sequencing_run_id: dict = field(default_factory=dict)
    outdir: Optional[os.PathLike] = None
    copy: bool = False
    csv: bool = False

    @classmethod
    def from_dict(cls, data: dict):
        # Get all valid field names for this dataclass
        valid_fields = {f.name for f in fields(cls)}
        # Filter the input dictionary
        filtered_data = {k: v for k, v in data.items() if k in valid_fields}
        return cls(**filtered_data)


def jdump(x):
    """
    Convenience method for debugging.
    """
    print(json.dumps(x, indent=2, cls=EnhancedJSONEncoder))


def configure_logging(config: Config):
    """
    Configure logging
    """
    log_level = 'error'
    if config.verbose:
        log_level = 'warning'
    logging.basicConfig(
        level=str.upper(log_level),
        format='%(asctime)s %(levelname)s: %(filename)s (%(funcName)s, line %(lineno)d): %(message)s',
        datefmt='%Y-%m-%dT%H:%M:%S'
    )

    return None


def parse_excluded_runs_file(excluded_runs_file):
    """
    Parse the excluded runs file, return as a set.

    :param excluded_runs_file:
    :type excluded_runs_file: str
    :return: excluded_runs
    :rtype: set[str]
    """
    excluded_runs = set()
    with open(excluded_runs_file, 'r') as f:
        for line in f:
            excluded_runs.add(line.strip())

    return excluded_runs


def parse_excluded_libraries_file(excluded_libs_file):
    """
    Parse the excluded libraries file, return as a dict, indexed by sequencing run ID.

    :param excluded_libs_file:
    :type excluded_libs_file: str
    :return: excluded_libraries_by_run
    :rtype: dict[str, set[str]]
    """
    excluded_libraries_by_run = {}
    with open(excluded_libs_file, 'r') as f:
        for line in f:
            sequencing_run_id, library_id = line.strip().split(',')
            if sequencing_run_id not in excluded_libraries_by_run:
                excluded_libraries_by_run[sequencing_run_id] = set()
            excluded_libraries_by_run[sequencing_run_id].add(library_id)

    return excluded_libraries_by_run


def parse_config(config_path):
    """
    Parse json-format config file, return as a dict.

    :param config_path:
    :type config_path: str
    :return: config
    :rtype: Config
    """
    config_dict = {}
    if not os.path.exists(config_path):
        logging.error(f"Config file does not exist: {config_path}")
        exit(-1)

    with open(config_path, 'r') as f:
        try:
            config_dict = json.load(f)
        except json.decoder.JSONDecodeError as e:
            logging.error(f"Error parsing config file: {config_path}")
            print(e, file=sys.stderr)
            exit(-1)

    if 'excluded_runs_file' in config_dict and os.path.exists(config_dict['excluded_runs_file']):
        config_dict['excluded_runs'] = parse_excluded_runs_file(config_dict['excluded_runs_file'])
    else:
        config_dict['excluded_runs'] = set()

    if 'excluded_libraries_file' in config_dict and os.path.exists(config_dict['excluded_libraries_file']):
        config_dict['excluded_libraries_by_sequencing_run_id'] = parse_excluded_libraries_file(config_dict['excluded_libraries_file'])
    else:
        config_dict['excluded_libraries_by_sequencing_run_id'] = {}

    if 'outdir' not in config_dict:
        config_dict['outdir'] = None

    if 'copy' not in config_dict:
        config_dict['copy'] = False

    if 'csv' not in config_dict:
        config_dict['csv'] = False

    if 'sequencing_run_parent_dirs' not in config_dict:
        logging.error(f"Config file missing required key 'sequencing_run_parent_dirs': {config_path}")
        exit(-1)
    
    config = Config(**config_dict)

    return config


def merge_config_with_args(config: Config, args):
    """
    Over-write any config values supplied as command-line args.

    :param config: Parsed config from file.
    :type config: Config
    :param args: command-line args.
    :type args: argparse.Namespace
    :return: merged config
    :rtype: Config
    """

    if args.simplify_sample_id:
        config.simplify_sample_id = args.simplify_sample_id

    if args.outdir:
        config.outdir = args.outdir

    if args.copy:
        config.copy = args.copy

    if args.csv:
        config.csv = args.csv

    if args.project_id:
        config.project_id = args.project_id

    if args.run_id:
        config.run_id = args.run_id

    if args.skip_qc_status_check:
        config.skip_qc_status_check = args.skip_qc_status_check

    if args.verbose:
        config.verbose = args.verbose

    if args.exclude_run is not None:
        config.excluded_runs.add(args.exclude_run)

    if args.excluded_runs_file is not None:
        excluded_runs_from_args = parse_excluded_runs_file(args.excluded_runs_file)
        config.excluded_runs = config.excluded_runs.union(excluded_runs_from_args)

    if args.excluded_libraries_file is not None:
        excluded_libraries_from_args = parse_excluded_libraries_file(args.excluded_libraries_file)
        for run_id, libraries in excluded_libraries_from_args.items():
            if run_id not in config.excluded_libraries_by_sequencing_run_id:
                config.excluded_libraries_by_sequencing_run_id[run_id] = set()
            config.excluded_libraries_by_sequencing_run_id[run_id] = config.excluded_libraries_by_sequencing_run_id[run_id].union(libraries)

    return config


# https://stackoverflow.com/a/1176023
def camel_to_snake(name):
    """
    Convert camelCase strings to snake_case strings

    :param name: The name to convert
    :type name: str
    :return: snake_case name
    :rtype: str
    """
    name = re.sub('(.)([A-Z][a-z]+)', r'\1_\2', name)
    return re.sub('([a-z0-9])([A-Z])', r'\1_\2', name).lower()


def determine_sequencer_type(run_id):
    """
    Determine sequencer type based on format of Run ID.
    Returns "miseq", "nextseq", "gridion", or None.

    :param run_id:
    :type run_id: str
    :return: sequencer type
    :rtype: str|None
    """
    if re.match(MISEQ_RUN_ID_REGEX, run_id):
        return "miseq"
    elif re.match(NEXTSEQ_RUN_ID_REGEX, run_id):
        return "nextseq"
    elif re.match(GRIDION_RUN_ID_REGEX, run_id):
        return "gridion"
    elif re.match(I100_RUN_ID_REGEX, run_id):
        return "i100"
    return None


def determine_miseq_directory_structure(run_dir_path):
    """
    Determine whether a MiSeq run directory follows the "old" or "new" directory structure.
    In the "old" structure, fastq files are always found under "Data/Intensities/BaseCalls".
    In the "new" structure, fastq files are found under "Alignment_N/DATE_TIME/Fastq"

    :param run_dir_path:
    :type run_dir_path: str
    :return: "old" or "new"
    :rtype: str
    """

    run_dir_contents = os.listdir(run_dir_path)
    if "Alignment_1" in run_dir_contents:
        old_or_new = "new"
    else:
        old_or_new = "old"

    return old_or_new


def find_miseq_fastq_subdir(run_dir_path):
    """
    Find the sub-directory where fastq files are located.
    MiSeq runs may follow an 'old' or 'new' directory structure.

    :param run_dir_path:
    :type run_dir_path: str
    :return: fastq subdir
    :rtype: str|None
    """
    fastq_subdir = None
    directory_structure = determine_miseq_directory_structure(run_dir_path)
    if directory_structure == "old":
        fastq_subdir = "Data/Intensities/BaseCalls"
    elif directory_structure == "new":
        # Sort glob results so we always pick the latest Alignment_N/timestamp/Fastq deterministically.
        fastq_dirs = sorted(glob.glob(os.path.join(run_dir_path, 'Alignment_*', '*', 'Fastq')))
        if fastq_dirs:
            fastq_subdir = os.path.relpath(fastq_dirs[-1], run_dir_path)
        else:
            print("WARNING: Failed to find fastq_directory in: " + run_dir_path, file=sys.stderr)

    return fastq_subdir


def parse_samplesheet_miseq(samplesheet_path):
    """
    Parse a MiSeq SampleSheet to get sample and project IDs

    :param samplesheet_path: SampleSheet.csv file.
    :type samplesheet_path: str
    :return: List of sample records from SampleSheet.
    :rtype: list[dict[str, object]]
    """
    data = []
    with open(samplesheet_path, 'r') as f:
        for line in f:
            if not line.strip().startswith('[Data]'):
                continue
            else:
                break
          
        data_header = [x.lower() for x in next(f).strip().split(',')]
      
        for line in f:
            if not all([x == '' for x in line.strip().split(',')]):
                data_line = {}
                for idx, data_element in enumerate(line.strip().split(',')):
                    try:
                        data_line[data_header[idx]] = data_element
                    except IndexError as e:
                        pass
                data.append(data_line)

    return data


def parse_samplesheet_nextseq(samplesheet_path):
    """
    Parse a NextSeq SampleSheet to get sample and project IDs

    :param samplesheet_path: Path to SampleSheet.csv file.
    :type samplesheet_path: str
    :return: List of sample records from SampleSheet.
    :rtype: list[dict[str, object]]
    """
    cloud_data_lines = []
    cloud_data = []
    with open(samplesheet_path, 'r') as f:
        for line in f:
            if line.strip().startswith('[Cloud_Data]'):
                break
        for line in f:
            if line.strip().startswith('[Cloud_Settings]') or line.strip().rstrip(',') == "":
                break
            cloud_data_lines.append(line.strip().rstrip(','))

    if cloud_data_lines:
        cloud_data_keys = [camel_to_snake(x) for x in cloud_data_lines[0].split(',')]
        for line in cloud_data_lines[1:]:
            d = {}
            values = line.strip().split(',')
            if not all([x == '' for x in values]):
                for idx, key in enumerate(cloud_data_keys):
                    try:
                        d[key] = values[idx]
                    except IndexError as e:
                        d[key] = ""
                cloud_data.append(d)
  
    return cloud_data


def parse_samplesheet_i100(samplesheet_path):
    """
    Parse a MiSeq i100 SampleSheet to get sample and project IDs
    currently just re-uses NextSeq samplesheet parser, as they use the same format.

    :param samplesheet_path: Path to SampleSheet.csv file.
    :type samplesheet_path: str
    :return: List of sample records from SampleSheet.
    :rtype: list[dict[str, object]]
    """
    cloud_data = parse_samplesheet_nextseq(samplesheet_path)

    return cloud_data


def parse_samplesheet_gridion(samplesheet_path):
    """
    Parse an ONT GridION sample sheet, extracting sample_id and project_id from the alias field.
    The alias field encodes both values as '{sample_id}_{project_id}'. Everything to the left
    of the first underscore is the sample ID; everything to the right is the project ID.

    :param samplesheet_path: Path to the sample sheet CSV
    :type samplesheet_path: str
    :return: List of sample dicts with 'sample_id', 'project_id', and 'barcode' keys
    :rtype: list[dict]
    """
    samples = []
    with open(samplesheet_path, 'r') as f:
        reader = csv.DictReader(f)
        for row in reader:
            alias = row.get('alias', '')
            if not alias:
                continue
            parts = alias.split('_', 1)
            sample_id = parts[0]
            project_id = parts[1] if len(parts) > 1 else ''
            samples.append({
                'sample_id': sample_id,
                'project_id': project_id,
                'barcode': row.get('barcode', ''),
            })
    return samples


def normalize_sample_id(sample_id):
    """
    Convert underscores to hyphens in a sample ID, matching sequencer filename behavior.
    Applied uniformly across all sequencer types before matching and globbing.

    :param sample_id:
    :type sample_id: str
    :return: normalized sample ID
    :rtype: str
    """
    return sample_id.replace('_', '-')


def has_necessary_fields_for_symlinking(sample, sequencer_type):
    """
    Check if a sample dict has the fields required for symlinking, given the sequencer type.
    For MiSeq, also populates sample_name from sample_id when sample_name is absent.

    :param sample:
    :type sample: dict[str, str]
    :param sequencer_type: "miseq", "nextseq", or "gridion"
    :type sequencer_type: str
    :return: Whether or not the sample has the fields necessary for symlinking
    :rtype: bool
    """
    if sequencer_type == 'miseq':
        if sample.get('sample_name'):
            pass
        elif sample.get('sample_id'):
            sample['sample_name'] = sample['sample_id']
        else:
            return False
        return 'sample_project' in sample
    elif sequencer_type == 'nextseq':
        return bool(sample.get('sample_id')) and 'project_name' in sample
    elif sequencer_type == 'i100':
        return bool(sample.get('sample_id')) and 'project_name' in sample
    elif sequencer_type == 'gridion':
        return bool(sample.get('sample_id'))
    
    return False


def get_latest_analysis_subdir(run_dir):
    """
    For NextSeq runs, there may be multiple Analysis sub-directories.
    Selects the latest by sorting directory names numerically where possible.
    Returns None if the Analysis directory does not exist or is empty.

    :param run_dir:
    :type run_dir: str
    :return: Path to latest analysis subdir, or None
    :rtype: str|None
    """
    analysis_dir = os.path.join(run_dir, "Analysis")
    if not os.path.exists(analysis_dir):
        return None
    subdirs = os.listdir(analysis_dir)
    if not subdirs:
        return None
    subdirs_sorted = sorted(subdirs, key=lambda x: int(x) if x.isdigit() else x)
    return os.path.abspath(os.path.join(run_dir, "Analysis", subdirs_sorted[-1]))


def create_symlinks(fastq_files, outdir):
    """
    Create a symlink in outdir for each FastqFile.
    Silently skips files that are already symlinked (errno 17 / EEXIST).

    :param fastq_files: list of FastqFile records
    :type fastq_files: list[FastqFile]
    :return: None
    :rtype: NoneType
    """
    for f in fastq_files:
        dest_path = os.path.join(outdir, f.dest_filename)
        try:
            os.symlink(f.src, dest_path)
        except OSError as e:
            if e.errno == 17:
                pass
            else:
                print(f"{e}. files: {f.src}, {dest_path}", file=sys.stderr)


def create_copies(fastq_files, outdir):
    """
    Copy each FastqFile source to outdir.

    :param fastq_files: list of FastqFile records
    :type fastq_files: list[FastqFile]
    :return: None
    :rtype: NoneType
    """
    for f in fastq_files:
        dest_path = os.path.join(outdir, f.dest_filename)
        shutil.copy(f.src, dest_path)


def parse_ids_file(ids_file_path):
    """
    Parse the user-supplied sample IDs file.

    :param ids_file_path: Path to sample IDs file. Should contain one sample ID per line.
    :type ids_file_path: str
    :return: Set of sample IDs
    :rtype: set[str]
    """
    sample_ids = set()
    with open(ids_file_path, 'r') as f:
        for line in f:
            sample_ids.add(line.strip())

    return sample_ids


def simplify_fastq_filename(sample_id, original_filename):
    """
    Simplify fastq filename of destination symlink/copy by removing SXX_L001_R{1,2}_001, replacing simply with R1, R2 or RL.

    :param sample_id:
    :type sample_id: str
    :param original_filename:
    :type original_filename:
    :return:
    :rtype: str
    """
    read = ""
    if re.search('_R1_', original_filename):
        read = 'R1'
    elif re.search('_R2_', original_filename):
        read = 'R2'
    elif re.search('_RL', original_filename):
        read = 'RL'
    extension = '.fastq'
    if original_filename.split('.')[-1] == 'gz':
        extension += '.gz'

    dest_filename = sample_id + '_' + read + extension

    return dest_filename


def select_miseq_samples(run_dir: Path, normalized_sample_ids: Optional[set[str]], project_id: Optional[str]=None):
    """
    Locate the MiSeq SampleSheet and return samples matching the given IDs or project,
    together with the path to the fastq subdirectory.

    normalized_sample_ids should already have underscores converted to hyphens, or be None.

    :param run_dir: Path to the MiSeq run directory
    :type run_dir: Path
    :param normalized_sample_ids: Set of normalized sample IDs to filter on, or None
    :type normalized_sample_ids: set[str]|None
    :param project_id: Project ID to filter on, or None
    :type project_id: str|None
    :return: (selected_samples, fastq_subdir)
    :rtype: tuple[list[dict], str|None]
    """
    run_id = run_dir.name
    miseq_dir_type = determine_miseq_directory_structure(run_dir)
    fastq_subdir = find_miseq_fastq_subdir(run_dir)

    samplesheet_paths = None
    if miseq_dir_type == 'old':
        samplesheet_paths = sorted(glob.glob(os.path.join(run_dir, 'SampleSheet*.csv')))
    elif miseq_dir_type == 'new' and fastq_subdir is not None:
        timestamped_dir = os.path.dirname(os.path.join(run_dir, fastq_subdir))
        samplesheet_paths = sorted(glob.glob(os.path.join(timestamped_dir, 'SampleSheet*.csv')))

    if not samplesheet_paths:
        logging.warning(f"Failed to find SampleSheet in: {run_dir}")
        return [], fastq_subdir

    samplesheet_path = samplesheet_paths[0]
    if len(samplesheet_paths) > 1:
        logging.warning(f"Found multiple SampleSheets in: {run_dir}. Using: {samplesheet_path}")
    if not samplesheet_path:
        logging.warning(f"Failed to find SampleSheet for run {run_id}")
        return [], fastq_subdir

    all_samples = parse_samplesheet_miseq(samplesheet_path)
    candidate_samples = [s for s in all_samples if has_necessary_fields_for_symlinking(s, 'miseq')]
    for s in candidate_samples:
        s['sample_id'] = normalize_sample_id(s['sample_id'])
        s['sample_name'] = normalize_sample_id(s['sample_name'])

    if normalized_sample_ids:
        selected = [s for s in candidate_samples
                    if s['sample_id'] in normalized_sample_ids
                    or s['sample_name'] in normalized_sample_ids]
    elif project_id is not None:
        selected = [s for s in candidate_samples if s['sample_project'] == project_id]
    else:
        selected = candidate_samples

    return selected, fastq_subdir


def select_nextseq_samples(run_dir: Path, normalized_sample_ids: Optional[set[str]], project_id: Optional[str]=None):
    """
    Locate the NextSeq SampleSheet and return samples matching the given IDs or project,
